{
  "name": "dsh-academic-review",
  "version": "0.3.0",
  "private": false,
  "description": "Unofficial DSH port of Academic Research Skills: a 5-seat journal peer-review panel driven by review-state tools, plus the deep-research skill served prompt-only.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "vendor",
    "vendor-manifest.json",
    "cordis.patch.yml",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "docs",
    "assets"
  ],
  "license": "CC-BY-NC-4.0",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "peer-review",
    "academic-review",
    "academic-research-skills"
  ],
  "engines": {
    "node": "^22.19.0 || >=24"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.client.json && tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test tests/*.test.mjs",
    "verify:vendor": "node scripts/vendor-upstream.mjs --check",
    "vendor": "node scripts/vendor-upstream.mjs",
    "test:e2e": "node scripts/e2e.mjs",
    "test:build-determinism": "node scripts/build-determinism.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.2 || 0.2.1-rc.4",
    "@deepseek-ai/dsh-commands": "0.2.1-rc.1 || 0.2.1-rc.2",
    "@deepseek-ai/dsh-skill": "0.2.1-rc.2 || 0.2.1-rc.4",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2 || 0.2.1-rc.4",
    "@deepseek-ai/schemastery": "^3.18.5"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent": {
      "optional": true
    },
    "@deepseek-ai/dsh-commands": {
      "optional": true
    },
    "@deepseek-ai/dsh-skill": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.2",
    "@deepseek-ai/dsh-api-session-controller": "0.2.1-rc.1",
    "@deepseek-ai/dsh-client-locale": "0.2.1-rc.1",
    "@deepseek-ai/dsh-client-store": "0.2.1-rc.1",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.1-rc.1",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "0.2.1-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.1",
    "@deepseek-ai/dsh-commands": "0.2.1-rc.1",
    "@deepseek-ai/dsh-scope": "0.2.1-rc.1",
    "@deepseek-ai/dsh-session": "0.2.1-rc.1",
    "@deepseek-ai/dsh-skill": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "3.18.5",
    "@types/node": "^22.10.0",
    "@types/react": "~18.3.31",
    "@types/react-dom": "18.3.7",
    "happy-dom": "^15.11.7",
    "lightningcss": "1.33.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsdown": "0.22.2",
    "typescript": "^5.9.3"
  }
}
